# Authoritative list of environment variables. Copy to .env and fill in real
# values. Never commit real values. Any new integration adds its variable here
# in the same commit.

# TigerGraph (Savanna or Community Edition, accessed via TigerGraph MCP).
# Holds the graph, the vector store and case memory: there is no second
# database. See docs/architecture.md sections 3.2 and 3.5.
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH_NAME=
TIGERGRAPH_TOKEN=

# LLM (Claude API)
ANTHROPIC_API_KEY=
